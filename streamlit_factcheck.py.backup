# --------------------------------------------------
# BACKEND INITIALIZATION
# --------------------------------------------------

@st.cache_resource(show_spinner=False)
def get_fact_checker():
    return FactChecker()


def get_evidence_records():
    try:
        return EvidenceStore().load_all()
    except Exception as exc:
        print(f"Could not load evidence records: {exc}")
        return []


# SIDEBAR
# --------------------------------------------------

with st.sidebar:
    st.markdown("## 🔎 VERITAS")
    st.caption("Evidence-Based Fact Verification")

    st.divider()

    st.markdown("### Navigation")
    page = st.radio(
        "Choose a section",
        ["Fact Checker", "Evidence Store", "About Project"],
        label_visibility="collapsed",
    )

    st.divider()

    records = get_evidence_records()
    verified_count = sum(
        1 for r in records
        if r.get("evidence_status") == "verified"
    )
    pending_count = sum(
        1 for r in records
        if r.get("evidence_status") == "pending_review"
    )

    st.markdown("### Knowledge Base")
    st.metric("Stored evidence records", len(records))
    st.metric("Verified records", verified_count)
    st.metric("Pending review", pending_count)

    st.divider()

    st.caption("NLP • Semantic Search • Natural Language Inference")


# --------------------------------------------------
# HERO
# --------------------------------------------------

st.markdown(
    """
    <div class="hero">
        <div class="section-label" style="color:#b9ccff;">
            AI-POWERED RESEARCH ASSISTANT
        </div>
        <h1>Separate claims from evidence.</h1>
        <p>
            Investigate claims using semantic retrieval and natural
            language inference. Explore the available evidence before
            drawing conclusions.
        </p>
    </div>
    """,
    unsafe_allow_html=True,
)


# --------------------------------------------------
# PAGE 1: FACT CHECKER
# --------------------------------------------------

if page == "Fact Checker":

    st.markdown("### Check a claim")
    st.write(
        "Enter a factual statement. The system will search its current "
        "evidence collection and evaluate relevant passages."
    )

    with st.form("fact_check_form"):
        claim = st.text_area(
            "Claim to investigate",
            placeholder=(
                "Example: Human activities are causing the current "
                "global warming."
            ),
            height=125,
            max_chars=2000,
        )

        submitted = st.form_submit_button(
            "🔍 Investigate claim",
            type="primary",
            use_container_width=True,
        )

    if submitted:
        claim = claim.strip()

        if len(claim) < 10:
            st.warning("Please enter a more detailed factual claim.")

        else:
            st.session_state["last_claim"] = claim

            try:
                with st.spinner(
                    "Searching evidence and evaluating relevant passages..."
                ):
                    checker = get_fact_checker()

                    captured_output = io.StringIO()

                    with contextlib.redirect_stdout(captured_output):
                        with contextlib.redirect_stderr(captured_output):
                            result = checker.check_claim(claim)

                    output = captured_output.getvalue()

                    st.session_state["last_output"] = output
                    st.session_state["last_result"] = (
                        result if result is not None else None
                    )
                    st.session_state["last_checked"] = (
                        datetime.now().strftime("%d %b %Y, %I:%M %p")
                    )

            except Exception as exc:
                st.error("The fact-checking pipeline encountered an error.")
                st.exception(exc)

    if st.session_state.get("last_claim"):
        st.divider()

        st.markdown("### Investigation results")
        st.caption(
            "Claim: " + st.session_state["last_claim"]
        )

        if st.session_state.get("last_checked"):
            st.caption(
                "Checked on " + st.session_state["last_checked"]
            )

        result = st.session_state.get("last_result")
        output = st.session_state.get("last_output", "")

        if isinstance(result, dict):
            verdict = (
                result.get("verdict")
                or result.get("label")
                or result.get("status")
            )

            if verdict:
                normalized = str(verdict).upper()

                if "INSUFFICIENT" in normalized:
                    st.warning("⚠️ " + str(verdict))
                elif "CONTRADICTED" in normalized:
                    st.error("⚠️ " + str(verdict))
                elif "SUPPORTED" in normalized:
                    st.success("✓ " + str(verdict))
                elif "MIXED" in normalized:
                    st.info("Evidence appears mixed.")

            st.markdown("#### Backend response")
            st.json(result)

        elif result is not None:
            st.markdown("#### Backend response")
            st.write(result)

        if output.strip():
            st.markdown("#### Evidence analysis")
            st.code(output, language="text")

        if not output.strip() and result is None:
            st.info(
                "The backend returned no displayable result. "
                "Check whether check_claim() prints or returns its analysis."
            )

        report = {
            "project": "Veritas - Evidence-Based Claim Verification",
            "claim": st.session_state["last_claim"],
            "checked_at": st.session_state.get("last_checked"),
            "backend_result": result,
            "analysis_output": output,
            "note": (
                "Automated model output is not proof of truth. "
                "Review source quality, context, and independent evidence."
            ),
        }

        try:
            report_json = json.dumps(
                report,
                ensure_ascii=False,
                indent=2,
                default=str,
            )

            st.download_button(
                "⬇️ Download investigation report (JSON)",
                data=report_json,
                file_name="fact_check_report.json",
                mime="application/json",
                use_container_width=True,
            )
        except Exception as exc:
            st.caption(f"Report export unavailable: {exc}")

    else:
        st.markdown("### How to use the fact checker")

        col1, col2, col3 = st.columns(3)

        with col1:
            st.markdown(
                """
                <div class="info-card">
                    <h4>01 · Enter a claim</h4>
                    Describe a factual statement you want to investigate.
                </div>
                """,
                unsafe_allow_html=True,
            )

        with col2:
            st.markdown(
                """
                <div class="info-card">
                    <h4>02 · Retrieve evidence</h4>
                    The semantic retrieval component searches stored
                    documents for relevant passages.
                </div>
                """,
                unsafe_allow_html=True,
            )

        with col3:
            st.markdown(
                """
                <div class="info-card">
                    <h4>03 · Review the result</h4>
                    The NLI model evaluates the relationship between
                    the claim and retrieved evidence.
                </div>
                """,
                unsafe_allow_html=True,
            )

        st.info(
            "The current knowledge base may not contain evidence for "
            "every topic. An unsupported claim is not automatically false."
        )


# --------------------------------------------------
# PAGE 2: EVIDENCE STORE
# --------------------------------------------------

elif page == "Evidence Store":

    st.markdown("### Evidence collection")
    st.write(
        "Browse the documents currently available to the fact-checking engine."
    )

    records = get_evidence_records()

    if not records:
        st.warning("No evidence records were found in the evidence store.")

    else:
        search_text = st.text_input(
            "Search evidence",
            placeholder="Search titles, publishers, or topics...",
        )

        statuses = sorted({
            str(r.get("evidence_status", "unknown"))
            for r in records
        })

        selected_status = st.selectbox(
            "Filter by review status",
            ["All statuses"] + statuses,
        )

        filtered_records = []

        for record in records:
            searchable = " ".join([
                str(record.get("title", "")),
                str(record.get("publisher", "")),
                str(record.get("topic", "")),
            ]).lower()

            if search_text.lower() not in searchable:
                continue

            status = str(record.get("evidence_status", "unknown"))

            if (
                selected_status != "All statuses"
                and status != selected_status
            ):
                continue

            filtered_records.append(record)

        st.caption(
            f"Showing {len(filtered_records)} of {len(records)} records"
        )

        for index, record in enumerate(filtered_records, start=1):
            title = record.get("title") or "Untitled source"
            publisher = record.get("publisher") or "Publisher unknown"
            topic = record.get("topic") or "Uncategorized"
            status = record.get("evidence_status", "unknown")
            url = record.get("url", "")
            text = record.get("text", "")

            with st.expander(f"{index}. {title}"):
                st.write(f"**Publisher:** {publisher}")
                st.write(f"**Topic:** {topic}")
                st.write(f"**Review status:** {status}")

                if record.get("published_date"):
                    st.write(
                        f"**Publication date:** "
                        f"{record['published_date']}"
                    )

                if url:
                    st.markdown(f"**Source:** [{url}]({url})")

                if text:
                    st.markdown("**Stored text / abstract**")
                    st.write(text[:4000])

                    if len(text) > 4000:
                        st.caption(
                            "Text shortened for display."
                        )

        st.download_button(
            "⬇️ Export evidence metadata (JSON)",
            data=json.dumps(
                filtered_records,
                ensure_ascii=False,
                indent=2,
                default=str,
            ),
            file_name="evidence_store_export.json",
            mime="application/json",
        )


# --------------------------------------------------
# PAGE 3: ABOUT
# --------------------------------------------------

elif page == "About Project":

    st.markdown("### About this project")

    st.write(
        """
        **Veritas: Fake News Detection Using Natural Language Processing
        and Evidence-Based Claim Verification**
        """
    )

    st.markdown("#### Project objectives")

    st.markdown(
        """
        - Investigate factual claims using an evidence collection.
        - Retrieve semantically relevant passages.
        - Apply Natural Language Inference (NLI) to assess relationships
          between claims and evidence.
        - Display source information and model output.
        - Communicate uncertainty rather than automatically labelling
          every claim as true or false.
        """
    )

    st.markdown("#### Technology stack")

    technologies = [
        ("Programming language", "Python"),
        ("Frontend", "Streamlit"),
        ("Semantic retrieval", "Sentence Transformers"),
        ("Inference model", "DeBERTa-based NLI cross-encoder"),
        ("Evidence sources", "Wikipedia and OpenAlex scholarly records"),
        ("Storage", "JSON Lines (JSONL)"),
    ]

    for technology, description in technologies:
        st.markdown(f"- **{technology}:** {description}")

    st.markdown("#### System workflow")

    st.code(
        "User Claim\n"
        "    ↓\n"
        "Semantic Evidence Retrieval\n"
        "    ↓\n"
        "Relevant Evidence Passages\n"
        "    ↓\n"
        "Natural Language Inference (NLI)\n"
        "    ↓\n"
        "Evidence Analysis and Source Review",
        language="text",
    )

    st.warning(
        "Research limitation: NLI scores are model predictions, not "
        "probabilities that a claim is true. The current evidence store "
        "is limited, some records remain pending review, and the system "
        "does not independently establish source credibility. Results "
        "must be interpreted alongside source quality, publication date, "
        "context, and corroborating evidence."
    )


# --------------------------------------------------
# FOOTER
# --------------------------------------------------

st.divider()

st.caption(
    "Veritas · NLP-Based Evidence Analysis · "
    "Research prototype, not an authoritative fact-checking service."
)
