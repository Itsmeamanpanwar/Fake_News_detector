import contextlib
import io
import json
from datetime import datetime

import streamlit as st

from factcheck_engine.services.fact_checker import FactChecker
from factcheck_engine.services.evidence_store import EvidenceStore


# --------------------------------------------------
# PAGE CONFIGURATION
# --------------------------------------------------

st.set_page_config(
    page_title="Veritas | AI Fact Checker",
    page_icon="🔎",
    layout="wide",
    initial_sidebar_state="expanded",
)


# --------------------------------------------------
# CUSTOM STYLING — WHITE AND RED
# --------------------------------------------------

st.markdown(
    """
    <style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');


    html, body, .stApp,
    [class*="css"],
    [data-testid="stMarkdownContainer"],
    [data-testid="stText"],
    .stButton button,
    .stTextInput input,
    .stTextArea textarea,
    label,
    p, span, div {
        font-family: "DM Sans", -apple-system, BlinkMacSystemFont,
                     "Segoe UI", sans-serif !important;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: "Manrope", "DM Sans", sans-serif !important;
        font-weight: 700 !important;
    }

